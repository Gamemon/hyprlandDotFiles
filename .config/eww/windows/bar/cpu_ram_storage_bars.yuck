;; ── Cpu ram storage ───────────────────────────────────────────────────
;; Text displaying cpu load, ram usage, storage
;; Anchored middle left

(defwindow cpu_ram_storage_bars
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :geometry (geometry :x "20px" :y "482px" :width "900px" :height "140px" :anchor "top left")
  :focusable false

  (box :orientation "vertical" :halign "start" :space "10px"
    ;; ==== CPU LOAD ====
(label :text "[ CPU LOAD ]" :class "stats-label" :halign "start" :show-truncated false)
(box :orientation "horizontal" :halign "start" :space "4px"
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "margin-top: -8px;"
    (label :text cpu_bar :class "ram-bar"))
  ;; Increased min-width to 75px & disabled truncation
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "min-width: 75px; padding: 0px;"  
    (label :text cpu_usage :class "ram-bar2" :halign "center" :show-truncated false))
)

;; ==== RAM USAGE ====
(label :text "[ RAM USAGE ]" :class "stats-label" :halign "start" :show-truncated false)
(box :orientation "horizontal" :halign "start" :space "4px"
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "margin-top: -8px;"
    (label :text ram_bar :class "ram-bar"))
  ;; Increased min-width to 75px & disabled truncation
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "min-width: 75px; padding: 0px;"
    (label :text ram_percent :class "ram-bar2" :halign "center" :show-truncated false))
)

;; ==== STORAGE REMAINING ====
(label :text "[ STORAGE ]" :class "stats-label" :halign "start" :show-truncated false)
(box :orientation "horizontal" :halign "start" :space "4px"
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "margin-top: -8px;"
    (label :text storage_bar :class "ram-bar"))
  ;; Increased min-width to 75px & disabled truncation
  (box :class "module-frame" :orientation "vertical" :halign "start" :style "min-width: 75px; padding: 0px;"
    (label :text storage_percent :class "ram-bar2" :halign "center" :show-truncated false))
)
  )
)
