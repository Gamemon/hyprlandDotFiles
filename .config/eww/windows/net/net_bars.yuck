(defwindow net_bars
  :visible show_eww
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry
    :x "80px"
    :y "750px"
    :width "300px"
    :height "180px"
    :anchor "top left")

  (box
    :orientation "horizontal"
    :space "20px"
    :halign "fill"

    ;; DL
    (box
      :orientation "vertical"
      :hexpand true
      :halign "center"

      (label :text "[ DL ]" :class "stats-label")

      (box :class "module-frame2"
        (label
            :text download_bar
            :show-truncated false
            :class "ram-bar"))

      (label
        :text download_speed
        :class "label-primary2"))

    ;; UL
    (box
      :orientation "vertical"
      :hexpand true
      :halign "center"

      (label :text "[ UL ]" :class "stats-label")

      (box :class "module-frame2"
        (label
          :text upload_bar
          :class "ram-bar"))

      (label
        :text upload_speed
        :class "label-primary2"))

    ;; PING
    (box
      :orientation "vertical"
      :hexpand true
      :halign "center"

      (label :text "[ PING ]" :class "stats-label")

      (box :class "module-frame2"
        (label
          :text ping_bar
          :class "ram-bar"))

      (label
        :text ping_ms
        :class "label-primary2"))

    ;; VPN
    (box
      :orientation "vertical"
      :hexpand true
      :halign "center"

      (label :text "[ VPN ]" :class "stats-label")

      (box :class "module-frame2"
        (label
            :text vpn_bar
            :class "ram-bar"))

      (label
        :text vpn_status_text
        :class "label-primary2"))
  ))
